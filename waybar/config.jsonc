{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "mod": "dock",
  "margin-top": 2,
  "height": 27,
  "margin-left": 5,
  "margin-right": 5,
  "margin-bottom": -1,
  "include": [
    "~/.config/waybar/modules.json"
  ],
  "group/left1": {
    "orientation": "inherit",
    "modules": [
      "custom/omarchy",
      "custom/idle-indicator",
      "custom/notification-silencing-indicator",
      "custom/voxtype",
      "idle_inhibitor",
      "custom/screenrecording-indicator",
      "custom/updatespacman",
      "custom/update"
    ]
  },
  "group/left2": {
    "orientation": "inherit",
    "modules": ["hyprland/workspaces"]
  },
  "group/left3": {
    "orientation": "inherit",
    "modules": ["mpris"]
  },
  "modules-left": ["group/left1", "group/left2", "group/left3"],
  "modules-center": ["hyprland/window"],
  "modules-right": [
    "group/tray-expander",
    "backlight",
    "hyprland/language",
    "pulseaudio",
    "pulseaudio#microphone",
    "bluetooth",
    "custom/tailscale",
    "network",
    "memory",
    "cpu",
    "battery",
    "custom/weather",
    "clock"
  ]
}
